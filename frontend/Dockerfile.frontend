# ============================================================
# frontend/Dockerfile.frontend
# ============================================================
# Multi-stage build for the React frontend.
# Stage 1: Build React app with Vite
# Stage 2: Serve with Nginx (lightweight production server)
#
# Build: docker build -f Dockerfile.frontend -t crop-frontend .
# Run:   docker run -p 3000:80 crop-frontend
# ============================================================

# ── Stage 1: Build ──────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files first (layer caching)
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm install --frozen-lockfile 2>/dev/null || npm install

# Copy source code
COPY . .

# Set backend URL for production build
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=$VITE_API_URL

# Build the React app
RUN npm run build

# ── Stage 2: Serve with Nginx ────────────────────────────────
FROM nginx:alpine AS production

# Copy built assets from stage 1
COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx config: SPA routing (all paths → index.html)
RUN echo 'server { \
    listen 80; \
    server_name _; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    location /api { \
        proxy_pass http://backend:8000; \
        proxy_set_header Host $host; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
